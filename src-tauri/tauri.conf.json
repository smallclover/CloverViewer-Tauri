{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloverViewer",
  "version": "0.1.2",
  "identifier": "com.smallclover.cloverviewer.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CloverViewer",
        "label": "main",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "smallclover",
    "category": "Utility",
    "copyright": "Copyright © 2026 smallclover",
    "shortDescription": "Lightweight image viewer with screenshot tools",
    "longDescription": "CloverViewer is a lightweight image viewer for Windows with a built-in screenshot annotator, OCR (Windows UWP), and an MCP server for tool-assisted workflows.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English", "Japanese"],
        "displayLanguageSelector": true
      }
    }
  }
}
